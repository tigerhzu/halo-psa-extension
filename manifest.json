{
  "manifest_version": 3,
  "name": "Tiger 的第三隻手",
  "version": "0.9.1",
  "minimum_chrome_version": "122",
  "description": "強化 HaloPSA 工單撰寫、Timesheet 與外觀。",
  "icons": {
    "16": "assets/icons/halo-logo16.png",
    "48": "assets/icons/halo-logo48.png",
    "128": "assets/icons/halo-logo128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*.openai.azure.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "HaloPSA Writing Helper 設定",
    "default_icon": {
      "16": "assets/icons/halo-logo16.png",
      "48": "assets/icons/halo-logo48.png",
      "128": "assets/icons/halo-logo128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.halopsa.com/*",
        "https://*.haloitsm.com/*",
        "https://*.halocrm.com/*",
        "https://*.haloservicedesk.com/*"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "js": ["src/ultimate-mode/bootstrap.js"],
      "css": ["src/ultimate-mode/ultimate.css"]
    },
    {
      "matches": [
        "https://*.halopsa.com/*",
        "https://*.haloitsm.com/*",
        "https://*.halocrm.com/*",
        "https://*.haloservicedesk.com/*"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN",
      "js": ["src/page/timesheet-bridge.js", "src/page/editor-probe-bridge.js"]
    },
    {
      "matches": [
        "https://*.halopsa.com/*",
        "https://*.haloitsm.com/*",
        "https://*.halocrm.com/*",
        "https://*.haloservicedesk.com/*"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "src/core/namespace.js",
        "src/config/selectors.js",
        "src/config/ai-actions.js",
        "src/core/pet-registry.js",
        "src/config/template-data.js",
        "src/config/format-rules.js",
        "src/config/besties-config.js",
        "src/config/time-adjuster-config.js",
        "src/core/editor-adapter.js",
        "src/core/html-sanitizer.js",
        "src/core/html-fidelity.js",
        "src/core/image-placeholder.js",
        "src/core/html-probe.js",
        "src/ai/ai-adapter.js",
        "src/ui/toast.js",
        "src/ui/loader.js",
        "src/ui/theme.js",
        "src/ui/preview-modal.js",
        "src/features/format-cleanup.js",
        "src/features/ticket-rich-format.js",
        "src/features/ai-rewrite.js",
        "src/features/note-window.js",
        "src/features/templates.js",
        "src/features/besties.js",
        "src/features/timesheet-align.js",
        "src/features/time-adjuster-core.js",
        "src/features/time-adjuster.js",
        "src/ui/toolbar.js",
        "src/ui/besties-toolbar.js",
        "src/ui/pet-animator.js",
        "src/ultimate-mode/shared.js",
        "src/ultimate-mode/sidebar.js",
        "src/ultimate-mode/team-shortcuts.js",
        "src/ultimate-mode/ticket-actions.js",
        "src/ultimate-mode/ticket-info.js",
        "src/ultimate-mode/user-info.js",
        "src/ultimate-mode/observer.js",
        "src/ultimate-mode/index.js",
        "src/ui/settings-panel.js",
        "src/core/editor-detector.js",
        "src/core/email-window-detector.js",
        "src/content.js"
      ],
      "css": ["src/styles/toolbar.css", "src/styles/modal.css", "src/styles/theme-cute-ios.css", "src/styles/settings-panel.css", "src/styles/timesheet-align.css", "src/styles/time-adjuster.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/codex-pets/*", "assets/ultimate-mode/*", "pet/*", "src/pets/*", "assets/icons/halo-logo48.png"],
      "matches": [
        "https://*.halopsa.com/*",
        "https://*.haloitsm.com/*",
        "https://*.halocrm.com/*",
        "https://*.haloservicedesk.com/*"
      ]
    }
  ]
}
