{
  "manifest_version": 3,
  "name": "Halopsa",
  "version": "1.1.2",
  "minimum_chrome_version": "122",
  "description": "Halo Companion：整合 AI 草稿預覽、範本、工單閱讀、原生工時調整與個人化工作台的 HaloPSA 輔助工具。",
  "icons": {
    "16": "assets/icons/companion16.png",
    "48": "assets/icons/companion48.png",
    "128": "assets/icons/companion128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.openai.azure.com/*",
    "https://ornith.example.invalid/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Halopsa 設定",
    "default_icon": {
      "16": "assets/icons/companion16.png",
      "48": "assets/icons/companion48.png",
      "128": "assets/icons/companion128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.halopsa.com/*",
        "https://*.haloitsm.com/*",
        "https://*.halocrm.com/*",
        "https://*.haloservicedesk.com/*"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "js": [
        "src/ultimate-mode/bootstrap.js"
      ],
      "css": [
        "src/ultimate-mode/ultimate.css",
        "src/styles/workbench.css"
      ]
    },
    {
      "matches": [
        "https://*.halopsa.com/*",
        "https://*.haloitsm.com/*",
        "https://*.halocrm.com/*",
        "https://*.haloservicedesk.com/*"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN",
      "js": [
        "src/page/timesheet-bridge.js",
        "src/page/editor-probe-bridge.js"
      ]
    },
    {
      "matches": [
        "https://*.halopsa.com/*",
        "https://*.haloitsm.com/*",
        "https://*.halocrm.com/*",
        "https://*.haloservicedesk.com/*"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "src/core/namespace.js",
        "src/config/selectors.js",
        "src/config/ai-actions.js",
        "src/core/pet-registry.js",
        "src/config/template-data.js",
        "src/config/besties-config.js",
        "src/config/time-adjuster-config.js",
        "src/core/editor-adapter.js",
        "src/core/html-sanitizer.js",
        "src/core/html-fidelity.js",
        "src/core/image-placeholder.js",
        "src/core/html-probe.js",
        "src/ai/provider-settings.js",
        "src/ai/ai-adapter.js",
        "src/ui/toast.js",
        "src/ui/loader.js",
        "src/ui/theme.js",
        "src/ui/preview-modal.js",
        "src/ui/category-picker.js",
        "src/features/ticket-rich-format.js",
        "src/features/ai-rewrite.js",
        "src/features/note-window.js",
        "src/features/ticket-reader.js",
        "src/features/templates.js",
        "src/features/besties.js",
        "src/features/timesheet-align.js",
        "src/features/time-adjuster-core.js",
        "src/features/time-adjuster.js",
        "src/ui/toolbar.js",
        "src/ui/besties-toolbar.js",
        "src/ui/pet-animator.js",
        "src/ultimate-mode/shared.js",
        "src/ultimate-mode/header.js",
        "src/ultimate-mode/sidebar.js",
        "src/ultimate-mode/team-shortcuts.js",
        "src/ultimate-mode/ticket-actions.js",
        "src/ultimate-mode/ticket-utilities.js",
        "src/ultimate-mode/ticket-info.js",
        "src/ultimate-mode/user-info.js",
        "src/ultimate-mode/observer.js",
        "src/ultimate-mode/index.js",
        "src/ui/settings-panel.js",
        "src/onboarding/index.js",
        "src/core/editor-detector.js",
        "src/core/email-window-detector.js",
        "src/content.js"
      ],
      "css": [
        "src/styles/toolbar.css",
        "src/styles/modal.css",
        "src/styles/category-picker.css",
        "src/styles/settings-panel.css",
        "src/styles/onboarding.css",
        "src/styles/timesheet-align.css",
        "src/styles/time-adjuster.css",
        "src/styles/ticket-reader.css",
        "src/styles/workbench-surfaces.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/codex-pets/*",
        "assets/ultimate-mode/*",
        "assets/branding/*",
        "pet/*",
        "src/pets/*",
        "assets/icons/halo-logo48.png",
        "src/styles/ticket-reader-window.css"
      ],
      "matches": [
        "https://*.halopsa.com/*",
        "https://*.haloitsm.com/*",
        "https://*.halocrm.com/*",
        "https://*.haloservicedesk.com/*"
      ]
    }
  ]
}
